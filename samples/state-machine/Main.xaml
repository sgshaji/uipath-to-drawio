<Activity mc:Ignorable="sap sap2010" x:Class="OrderRobot"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Made-up sample for uipath-to-drawio. A state machine shaped like a typical
       "get item, process item" robot. Uses the newer ViewStateManager layout format. -->
  <x:Members>
    <x:Property Name="in_OrderQueue" Type="InArgument(x:String)" />
  </x:Members>
  <sap2010:WorkflowViewState.IdRef>OrderRobot_1</sap2010:WorkflowViewState.IdRef>
  <StateMachine DisplayName="Order Robot" sap2010:WorkflowViewState.IdRef="StateMachine_1">
    <StateMachine.InitialState>
      <State x:Name="__ReferenceID0" DisplayName="Start Up" sap2010:WorkflowViewState.IdRef="State_1">
        <State.Entry>
          <Sequence DisplayName="Start up" sap2010:WorkflowViewState.IdRef="Sequence_1">
            <ui:InvokeWorkflowFile DisplayName="Read settings" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" WorkflowFileName="Framework\ReadSettings.xaml" />
            <ui:InvokeWorkflowFile DisplayName="Open applications" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" WorkflowFileName="Framework\OpenApps.xaml" />
          </Sequence>
        </State.Entry>
        <State.Transitions>
          <Transition DisplayName="Ready" sap2010:WorkflowViewState.IdRef="Transition_1" Condition="[StartUpError Is Nothing]">
            <Transition.To>
              <State x:Name="__ReferenceID1" DisplayName="Fetch Next Order" sap2010:WorkflowViewState.IdRef="State_2">
                <State.Entry>
                  <ui:InvokeWorkflowFile DisplayName="Get next order" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_3" WorkflowFileName="Framework\GetNextOrder.xaml" />
                </State.Entry>
                <State.Transitions>
                  <Transition DisplayName="Order found" sap2010:WorkflowViewState.IdRef="Transition_3">
                    <Transition.Condition>[CurrentOrder IsNot Nothing]</Transition.Condition>
                    <Transition.To>
                      <State x:Name="__ReferenceID2" DisplayName="Handle Order" sap2010:WorkflowViewState.IdRef="State_3">
                        <State.Entry>
                          <Sequence DisplayName="Handle order" sap2010:WorkflowViewState.IdRef="Sequence_2">
                            <TryCatch DisplayName="Try handling" sap2010:WorkflowViewState.IdRef="TryCatch_1">
                              <TryCatch.Try>
                                <ui:InvokeWorkflowFile DisplayName="Handle one order" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_4" WorkflowFileName="HandleOrder.xaml" />
                              </TryCatch.Try>
                            </TryCatch>
                            <ui:InvokeWorkflowFile DisplayName="Record result" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_5" WorkflowFileName="Framework\RecordResult.xaml" />
                          </Sequence>
                        </State.Entry>
                        <State.Transitions>
                          <Transition DisplayName="Done" sap2010:WorkflowViewState.IdRef="Transition_5" To="{x:Reference __ReferenceID1}" Condition="[OrderError Is Nothing]" />
                          <Transition DisplayName="Business error" sap2010:WorkflowViewState.IdRef="Transition_6" To="{x:Reference __ReferenceID1}" Condition="[TypeOf OrderError Is BusinessRuleException]" />
                          <Transition DisplayName="System error" sap2010:WorkflowViewState.IdRef="Transition_7" To="{x:Reference __ReferenceID0}" Condition="[TypeOf OrderError Is SystemException]" />
                        </State.Transitions>
                      </State>
                    </Transition.To>
                  </Transition>
                  <Transition DisplayName="No more orders" sap2010:WorkflowViewState.IdRef="Transition_4" Condition="[CurrentOrder Is Nothing]">
                    <Transition.To>
                      <State x:Name="__ReferenceID3" DisplayName="Wrap Up" sap2010:WorkflowViewState.IdRef="State_4" IsFinal="True">
                        <State.Entry>
                          <ui:InvokeWorkflowFile DisplayName="Close applications" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_6" WorkflowFileName="Framework\CloseApps.xaml" />
                        </State.Entry>
                      </State>
                    </Transition.To>
                  </Transition>
                </State.Transitions>
              </State>
            </Transition.To>
          </Transition>
          <Transition DisplayName="Start-up failed" sap2010:WorkflowViewState.IdRef="Transition_2" To="{x:Reference __ReferenceID3}" Condition="[StartUpError IsNot Nothing]" />
        </State.Transitions>
      </State>
    </StateMachine.InitialState>
    <x:Reference>__ReferenceID1</x:Reference>
    <x:Reference>__ReferenceID2</x:Reference>
    <x:Reference>__ReferenceID3</x:Reference>
  </StateMachine>
  <sap2010:WorkflowViewState.ViewStateManager>
    <sap2010:ViewStateManager>
      <sap2010:ViewStateData Id="StateMachine_1">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">60,42.5</av:Point>
            <av:PointCollection x:Key="ConnectorLocation">120,80 240,80</av:PointCollection>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
      </sap2010:ViewStateData>
      <sap2010:ViewStateData Id="State_1">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">240,30</av:Point>
            <av:Size x:Key="ShapeSize">160,100</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
      </sap2010:ViewStateData>
      <sap2010:ViewStateData Id="State_2">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">240,220</av:Point>
            <av:Size x:Key="ShapeSize">180,100</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
      </sap2010:ViewStateData>
      <sap2010:ViewStateData Id="State_3">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">240,420</av:Point>
            <av:Size x:Key="ShapeSize">200,110</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
      </sap2010:ViewStateData>
      <sap2010:ViewStateData Id="State_4">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">560,220</av:Point>
            <av:Size x:Key="ShapeSize">160,100</av:Size>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
      </sap2010:ViewStateData>
      <sap2010:ViewStateData Id="Transition_1">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:PointCollection x:Key="ConnectorLocation">320,130 320,220</av:PointCollection>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
      </sap2010:ViewStateData>
      <sap2010:ViewStateData Id="Transition_2">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:PointCollection x:Key="ConnectorLocation">400,60 640,60 640,220</av:PointCollection>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
      </sap2010:ViewStateData>
      <sap2010:ViewStateData Id="Transition_3">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:PointCollection x:Key="ConnectorLocation">330,320 330,420</av:PointCollection>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
      </sap2010:ViewStateData>
      <sap2010:ViewStateData Id="Transition_4">
        <sap:WorkflowViewStateService.ViewState>
