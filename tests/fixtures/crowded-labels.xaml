<Activity mc:Ignorable="sap sap2010" x:Class="CrowdedLabels"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Made-up test input. A flowchart with a saved Studio layout, drawn as saved.
       "Ready?"   no arrow meets its bottom point, so its text stays centred below it, and its branch
                  labels are already in clear places, so they stay halfway along their arrows.
       "Checked?" its False branch leaves from the bottom point, which would run through the text
                  below the diamond; and its two branches run side by side to "Finish", so both labels
                  would sit at the same spot halfway along. -->
  <Flowchart DisplayName="Crowded labels">
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <av:Point x:Key="ShapeLocation">270,0</av:Point>
        <av:Size x:Key="ShapeSize">60,75</av:Size>
        <av:PointCollection x:Key="ConnectorLocation">300,75 300,120</av:PointCollection>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Flowchart.StartNode>
      <FlowDecision x:Name="__ReferenceID0" DisplayName="Ready?" Condition="[ready]">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <av:Point x:Key="ShapeLocation">265,120</av:Point>
            <av:Size x:Key="ShapeSize">70,70</av:Size>
            <av:PointCollection x:Key="TrueConnector">335,155 520,155 520,200</av:PointCollection>
            <av:PointCollection x:Key="FalseConnector">265,155 100,155 100,600 200,600</av:PointCollection>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <FlowDecision.True>
          <FlowStep x:Name="__ReferenceID1">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <av:Point x:Key="ShapeLocation">420,200</av:Point>
                <av:Size x:Key="ShapeSize">200,52</av:Size>
                <av:PointCollection x:Key="ConnectorLocation">520,252 520,280 300,280 300,300</av:PointCollection>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <Assign DisplayName="Prepare" />
            <FlowStep.Next>
              <FlowDecision x:Name="__ReferenceID2" DisplayName="Checked?" Condition="[checked]">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <av:Point x:Key="ShapeLocation">265,300</av:Point>
                    <av:Size x:Key="ShapeSize">70,70</av:Size>
                    <x:String x:Key="TrueLabel">Yes, it is checked</x:String>
                    <x:String x:Key="FalseLabel">No, not checked</x:String>
                    <av:PointCollection x:Key="TrueConnector">335,335 720,335 720,600 400,600</av:PointCollection>
                    <av:PointCollection x:Key="FalseConnector">300,370 300,390 705,390 705,615 400,615</av:PointCollection>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <FlowDecision.True>
                  <x:Reference>__ReferenceID3</x:Reference>
                </FlowDecision.True>
                <FlowDecision.False>
                  <x:Reference>__ReferenceID3</x:Reference>
                </FlowDecision.False>
              </FlowDecision>
            </FlowStep.Next>
          </FlowStep>
        </FlowDecision.True>
        <FlowDecision.False>
          <FlowStep x:Name="__ReferenceID3">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <av:Point x:Key="ShapeLocation">200,575</av:Point>
                <av:Size x:Key="ShapeSize">200,50</av:Size>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <Assign DisplayName="Finish" />
          </FlowStep>
        </FlowDecision.False>
      </FlowDecision>
    </Flowchart.StartNode>
    <x:Reference>__ReferenceID1</x:Reference>
    <x:Reference>__ReferenceID2</x:Reference>
    <x:Reference>__ReferenceID3</x:Reference>
  </Flowchart>
</Activity>
